# Copie para .env e preencha. Nada aqui é obrigatório para testar localmente.

COMPANY_NAME=Towing J&J
PORT=3000
TIME_ZONE=America/New_York

# Tabela de preço (US$). Valor sugerido = base + milhas x preço por milha.
PRICE_BASE=75
PRICE_PER_MILE=4

# Dados do Zelle que vão na mensagem de cobrança ao cliente.
ZELLE_NAME=Towing J&J
ZELLE_CONTACT=(508) 555-0100

# Módulos ligados (separados por vírgula). Tire um da lista para desligar.
MODULES=vin,fotos,pagamentos,despesas,whatsapp

# WhatsApp Business (Meta Cloud API) — veja o README.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha-uma-senha-qualquer
WHATSAPP_APP_SECRET=

# Leitura do VIN por foto (opcional). Chave em console.anthropic.com.
ANTHROPIC_API_KEY=

# Em produção (com https), deixe 1.
SECURE_COOKIES=1
